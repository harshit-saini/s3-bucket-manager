generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @map("_id")
  email          String   @unique
  storageUsed    BigInt   @default(0)
  storageLimit   BigInt   @default(1073741824)
  plan           String   @default("FREE")
  createdAt      DateTime @default(now())
}
